{
    "name": "helpvox/sdk",
    "description": "Official PHP SDK for the HelpVox app platform: OAuth install, REST API, signed events, agent tools and dashboard session tokens.",
    "type": "library",
    "license": "MIT",
    "keywords": ["helpvox", "voice agent", "woocommerce", "opencart", "webhooks", "oauth"],
    "homepage": "https://www.helpvox.ai/docs/apps",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "HelpVox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HelpVox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
